{
    "name": "fishpig/magento2-wordpress-integration-yoastseo",
    "description": "Magento 2 WordPress Inegration Addon module to support the WordPress SEO plugin by Yoast.",
    "version": "3.3.17",
    "type": "magento2-module",
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "FishPig\\WordPress_Yoast\\": ""
        }
    },
    "require": {
        "fishpig/magento2-wordpress-integration": "^3.29.0"
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
